# Required for production Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=http://localhost:8787

# Optional: secret used to sign cookies/state (auto-generated to .data/secret if unset)
# SESSION_SECRET=

# Dev bypass: set DEV_AUTH=1 to enable "Continue as dev" without Google
# (also auto-enabled when NODE_ENV=test / running bun test)
DEV_AUTH=1

# Listen port (default 8787)
PORT=8787

# SQLite path (default .data/todo.db)
# DATABASE_PATH=.data/todo.db
