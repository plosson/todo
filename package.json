    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
