{
  "name": "todo",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Personal tags-only todo service with Google OIDC and device OAuth for AgentIO",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
